<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:id="@+id/imageLogo"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/bg_logo"
        android:contentDescription="@string/welcome_logo_description"
        android:src="@drawable/ic_launcher_foreground" />

    <Space
        android:layout_width="wrap_content"
        android:layout_height="24dp" />

    <TextView
        android:id="@+id/textTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/welcome_title"
        android:textColor="@color/brand_text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <Space
        android:layout_width="wrap_content"
        android:layout_height="8dp" />

    <TextView
        android:id="@+id/textSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/welcome_subtitle"
        android:textColor="@color/brand_text_secondary"
        android:textSize="16sp" />

    <Space
        android:layout_width="wrap_content"
        android:layout_height="40dp" />

    <Button
        android:id="@+id/buttonStart"
        style="@style/Widget.AppCompat.Button.Colored"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/welcome_start_button"
        android:textAllCaps="false"
        android:textColor="@color/brand_on_primary"
        android:textSize="16sp" />

</LinearLayout>
